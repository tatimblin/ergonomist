---
/**
 * Every page: the head (its feeds, Open Graph tags with an image to share it
 * with, structured data, and the analytics beacon once paper.analytics is
 * set), the masthead, the section nav and the footer (the
 * paper's own pages, the lists and feeds, the newsletter ask, the
 * disclaimer, and the line that says what's satire). Bare
 * HTML on purpose — paper.css is empty until there is enough in the paper to
 * design around; the markup is written so a stylesheet is all a design needs.
 */
import "./paper.css";
import { formatDate, sectionHref, type Paper, type ShareImage } from "./paper";

interface Props {
	paper: Paper;
	/** The page's own title; the paper's name alone on the front page. */
	title?: string;
	description?: string;
	/** Absolute. Defaults to this page on the paper's own site; a copied
	 *  story passes where it was first published; `false` for none (the 404,
	 *  which is served at every missing URL). */
	canonical?: string | false;
	/** Keep this page out of search even when the paper is indexed. */
	noindex?: boolean;
	/** The masthead's issue line. */
	issue?: { number: number; date: Date };
	/** "article" on a story's page (og:type). */
	type?: "website" | "article";
	/** schema.org structured data for the page, printed as JSON-LD; a list
	 *  is printed as one @graph. */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** The page's own RSS feed, advertised beside the paper's. */
	feed?: { title: string; href: string };
	/** The image the page is shared with (shareImage); the paper's default
	 *  card when left out. */
	image?: ShareImage;
	/** A story's dates, section and tags, as article:* Open Graph tags. */
	article?: { published: Date; modified: Date; section: string; tags: string[] };
}

const {
	paper,
	title,
	description = paper.tagline,
	canonical,
	noindex,
	issue,
	type = "website",
	jsonLd,
	feed,
	image = paper.card,
	article,
} = Astro.props;
const href = canonical === false ? undefined : (canonical ?? new URL(Astro.url.pathname, paper.site).href);
// Link previews need an absolute image URL.
const imageUrl = new URL(image.src, paper.site).href;
const isFront = Astro.url.pathname === "/";
// "page" on a section's own page, "true" on its stories: they're in it, not it.
const current = (section: string) =>
	Astro.url.pathname === sectionHref(section) ? "page" : Astro.url.pathname.startsWith(sectionHref(section)) ? "true" : undefined;
// JSON.stringify leaves "</script>" in a string as is; escaped, it can't close the tag.
const ld =
	jsonLd &&
	JSON.stringify({ "@context": "https://schema.org", ...(Array.isArray(jsonLd) ? { "@graph": jsonLd } : jsonLd) }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title ? `${title} — ${paper.name}` : paper.name}</title>
		<meta name="description" content={description} />
		{/* data-noindex says why: "page" (it's noindex in its own right) or "paper" (the whole paper is); scripts/smoke.ts reads it. */}
		{(noindex || !paper.index) && <meta name="robots" content="noindex, follow" data-noindex={noindex ? "page" : "paper"} />}
		{href && <link rel="canonical" href={href} />}
		<link rel="alternate" type="application/rss+xml" title={paper.name} href="/rss.xml" />
		<link rel="alternate" type="application/feed+json" title={paper.name} href="/feed.json" />
		{feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />}
		<meta property="og:site_name" content={paper.name} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title ?? paper.name} />
		<meta property="og:description" content={description} />
		{href && <meta property="og:url" content={href} />}
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={image.alt} />
		<meta property="og:image:width" content={String(image.width)} />
		<meta property="og:image:height" content={String(image.height)} />
		{article && (
			<>
				<meta property="article:published_time" content={article.published.toISOString()} />
				<meta property="article:modified_time" content={article.modified.toISOString()} />
				<meta property="article:section" content={article.section} />
				{article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
			</>
		)}
		<meta name="twitter:card" content="summary_large_image" />
		{ld && <script type="application/ld+json" is:inline set:html={ld} />}
		{/* Cloudflare Web Analytics: cookieless, and only once paper.analytics is set. */}
		{paper.analytics && (
			<script
				is:inline
				defer
				src="https://static.cloudflareinsights.com/beacon.min.js"
				data-cf-beacon={JSON.stringify({ token: paper.analytics })}
			/>
		)}
		<slot name="head" />
	</head>
	<body>
		<a href="#main">Skip to content</a>
		<header>
			{isFront ? <h1>{paper.name}</h1> : <p><a href="/">{paper.name}</a></p>}
			<p>{paper.tagline}</p>
			{issue && (
				<p>
					Vol. I, No. {issue.number} · <time datetime={issue.date.toISOString().slice(0, 10)}>{formatDate(issue.date)}</time> · {paper.price}
				</p>
			)}
			<nav aria-label="Sections">
				<ul>
					{paper.sections.map((s) => (
						<li>
							<a href={sectionHref(s.id)} aria-current={current(s.id)}>
								{s.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
			<form role="search" action="/search/">
				<label>Search <input type="search" name="q" /></label>
				<button type="submit">Search</button>
			</form>
		</header>
		<main id="main">
			<slot />
		</main>
		<footer>
			<nav aria-label="The paper">
				<ul>
					<li><a href="/about/">About</a></li>
					<li><a href="/staff/">Staff</a></li>
					<li><a href={paper.standards}>Standards</a></li>
					<li><a href="/corrections/">Corrections</a></li>
					<li><a href="/tips/">Tips</a></li>
				</ul>
			</nav>
			<nav aria-label="Everything else">
				<ul>
					<li><a href="/newswire/">Newswire</a></li>
					<li><a href="/latest/">Latest</a></li>
					<li><a href="/archive/">Archive</a></li>
					<li><a href="/places/">Places</a></li>
					<li><a href="/search/">Search</a></li>
					<li><a href="/rss.xml">RSS</a></li>
					<li><a href="/feeds/">Feeds</a></li>
				</ul>
			</nav>
			{paper.asks?.newsletter && <p>{paper.asks.newsletter} <a href="/rss.xml">RSS</a></p>}
			<p>{paper.disclaimer}</p>
			<p><a href={paper.standards}>Satire unless marked Reported.</a></p>
			<p>© {new Date().getFullYear()} {paper.name}.</p>
		</footer>
	</body>
</html>
