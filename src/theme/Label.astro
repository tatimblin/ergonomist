---
/**
 * What kind of story it is, printed wherever it is: "Satire"; "Reported"
 * and, with `source`, a link to what it's based on and the outlet it came
 * through ("via Mission Local"); "Column", a copied post (its page says
 * where it was first published); or nothing. `after` is the separator to
 * print after it, so none is left when there's no label.
 */
import { outletOf, veracityOf, type Story } from "./paper";

interface Props {
	story: Story;
	/** Link a reported story's source (on its own page). */
	source?: boolean;
	after?: string;
}

const { story, source: withSource, after = "" } = Astro.props;
const { veracity, source, via } = veracityOf(story);
---

{veracity === "reported" ? (
	<>Reported{withSource && source && <> · Source: <a href={source}>{new URL(source).host}</a></>}{withSource && via && <> · via <a href={via}>{outletOf(via)}</a></>}{after}</>
) : veracity === "column" ? (
	<>Column{after}</>
) : veracity === "satire" ? (
	<>Satire{after}</>
) : null}
