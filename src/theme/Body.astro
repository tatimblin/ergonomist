---
/**
 * A story's body. A dateline heads it in caps, "MISSION DISTRICT, S.F.—", as
 * a <strong> just before the first paragraph; a stylesheet can run it in.
 *
 * A recipe's headnote (markdown.ts takes it out of the body) prints first,
 * then whatever's in the slot (the recipe card), then the rest: the Method
 * and the notes.
 */
import { render } from "astro:content";
import { recipeOf, type Story } from "./paper";
import "./embeds.css";

interface Props {
	story: Story;
}

const { story } = Astro.props;
const { Content } = await render(story.entry);
const local = story.origin === "local" ? story : null;
const dateline = local?.entry.data.dateline;
const headnote = local?.entry.data.kind === "recipe" ? recipeOf(local).headnote : undefined;
---

{dateline && <strong>{dateline.toUpperCase()}—</strong>}
{headnote && <Fragment set:html={headnote} />}
<slot />
<Content />
