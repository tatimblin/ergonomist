---
/**
 * One story on its own page. A copied story names where it was first
 * published, its canonical link points there, and it is noindex: the search
 * result belongs to the original (Google's advice for syndicated copies).
 * Every story ends with its authors' bio box.
 */
import { render } from "astro:content";
import AuthorBox from "./AuthorBox.astro";
import Byline from "./Byline.astro";
import Layout from "./Layout.astro";
import { authorLd, formatDate, organizationLd, sectionHref, type Paper, type Story } from "./paper";

interface Props {
	paper: Paper;
	story: Story;
}

const { paper, story } = Astro.props;
const { Content } = await render(story.entry);
const data = story.entry.data;
const section = paper.sections.find((s) => s.id === story.section)!;
const local = story.origin === "local" ? story.entry.data : null;
const copied = story.origin === "feed" ? story.entry.data : null;
const recipe = local?.kind === "recipe" ? local : null;
const url = new URL(Astro.url.pathname, paper.site).href;
// Structured data for the paper's own stories (a copy's belongs to its
// original). schema.org has a type for exactly this: SatiricalArticle.
const jsonLd = local && {
	"@type": recipe ? "Recipe" : "SatiricalArticle",
	headline: local.title,
	name: local.title,
	description: local.summary,
	datePublished: local.date.toISOString(),
	url,
	author: authorLd(paper, story.authors),
	publisher: organizationLd(paper),
	...(recipe && { recipeIngredient: recipe.ingredients, ...(recipe.serves && { recipeYield: recipe.serves }) }),
};
---

<Layout paper={paper} title={data.title} description={data.summary} canonical={copied?.canonical} noindex={!!copied} type="article" jsonLd={jsonLd || undefined}>
	<article>
		<header>
			<p><a href={sectionHref(section.id)}>{section.label}</a></p>
			<h1>{data.title}</h1>
			{data.summary && <p>{data.summary}</p>}
			<p>By <Byline authors={story.authors} /></p>
			{/* Each author's title under the byline; with two or more, named. */}
			<p>{story.authors.map((a) => (story.authors.length > 1 ? `${a.data.name}, ${a.data.title}` : a.data.title)).join("; ")}</p>
			<p><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></p>
			{copied && (
				<p>
					First published at <a href={copied.canonical}>{copied.source}</a>.
				</p>
			)}
		</header>
		{recipe && (
			<section aria-labelledby="ingredients">
				<h2 id="ingredients">Ingredients</h2>
				{(recipe.serves || recipe.time) && (
					<p>{[recipe.serves && `Serves ${recipe.serves}`, recipe.time].filter(Boolean).join(" · ")}</p>
				)}
				<ul>
					{recipe.ingredients!.map((i) => <li>{i}</li>)}
				</ul>
			</section>
		)}
		{recipe && <h2>Method</h2>}
		<Content />
		<AuthorBox authors={story.authors} />
	</article>
</Layout>
