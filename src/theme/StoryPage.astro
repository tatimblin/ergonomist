---
/**
 * One story on its own page, top to bottom: kicker, headline and dek; byline,
 * dates and reading time; Satire or Reported; the lead image; the body; the
 * update note and corrections; tags; the authors' bio box; then related
 * stories and the stories either side of it in its section.
 *
 * A copied story names where it was first published, its canonical link
 * points there, and it is noindex: the search result belongs to the original
 * (Google's advice for syndicated copies). A tidbit is noindex too: a
 * paragraph is too thin a page to send searchers to; it's on the front page.
 * Only the paper's own stories are in the site search (data-pagefind-body).
 *
 * A recipe's body opens with its headnote, then its card (RecipeCard), then
 * the Method and notes. Its header links to the card ("Jump to recipe") and
 * has a Print button, the page's only script; print.css prints the recipe
 * and nothing around it, with a "Clipped from" line that shows only there.
 */
import { Image } from "astro:assets";
import "./print.css";
import AuthorBox from "./AuthorBox.astro";
import Body from "./Body.astro";
import Byline from "./Byline.astro";
import Label from "./Label.astro";
import Layout from "./Layout.astro";
import RecipeCard from "./RecipeCard.astro";
import StoryList from "./StoryList.astro";
import {
	authorLd,
	breadcrumbLd,
	formatDate,
	kickerOf,
	modifiedOf,
	organizationLd,
	readingMinutes,
	recipeLd,
	relatedStories,
	sectionHref,
	sectionNeighbours,
	seriesHref,
	storyHref,
	tagHref,
	tagLabel,
	tagsOf,
	veracityOf,
	type Paper,
	type Story,
} from "./paper";

interface Props {
	paper: Paper;
	story: Story;
	/** Every story, newest first (getStories): for related and previous/next. */
	stories: Story[];
}

const { paper, story, stories } = Astro.props;
const data = story.entry.data;
const section = paper.sections.find((s) => s.id === story.section)!;
const local = story.origin === "local" ? story.entry.data : null;
const copied = story.origin === "feed" ? story.entry.data : null;
const recipe = story.origin === "local" && story.entry.data.kind === "recipe" ? story : null;
const tidbit = local?.kind === "tidbit";
const kicker = kickerOf(story);
const { veracity, source } = veracityOf(story);
const updated = modifiedOf(story).getTime() !== data.date.getTime() ? modifiedOf(story) : undefined;
const tags = tagsOf(story);
const related = relatedStories(story, stories);
const { previous, next } = sectionNeighbours(story, stories);
const url = new URL(Astro.url.pathname, paper.site).href;
const image = local?.image;
// A satire's description says so, wherever it's quoted out of the page.
const description = veracity === "satire" ? `Satire: ${data.dek ?? data.title}` : data.dek;
// Structured data for the paper's own stories (a copy's belongs to its
// original). schema.org has a type for exactly this: SatiricalArticle.
const jsonLd = local && [
	{
		"@type": recipe ? "Recipe" : veracity === "reported" ? "NewsArticle" : "SatiricalArticle",
		headline: local.title,
		name: local.title,
		description: local.dek,
		datePublished: local.date.toISOString(),
		dateModified: modifiedOf(story).toISOString(),
		url,
		mainEntityOfPage: url,
		...(image && { image: new URL(image.src.src, paper.site).href }),
		...(tags.length && { keywords: tags }),
		...(veracity === "reported" && { isBasedOn: source }),
		author: authorLd(paper, story.authors),
		publisher: organizationLd(paper),
		// Its times, yield, ingredients and steps; and an image whether or not it has one.
		...(recipe && recipeLd(paper, recipe, url)),
	},
	breadcrumbLd(paper, [
		[paper.name, "/"],
		[section.label, sectionHref(section.id)],
		[local.title, storyHref(story)],
	]),
];
---

<Layout
	paper={paper}
	title={data.title}
	description={description}
	canonical={copied?.canonical}
	noindex={!!copied || tidbit}
	type="article"
	jsonLd={jsonLd || undefined}
>
	<nav aria-label="Breadcrumb"><a href={sectionHref(section.id)}>{section.label}</a></nav>
	<article data-pagefind-body={local ? "" : undefined} data-recipe={recipe ? "" : undefined}>
		<header>
			{kicker && <p>{story.series ? <a href={seriesHref(story.series.id)}>{kicker}</a> : kicker}</p>}
			<h1>{data.title}</h1>
			{data.dek && <p>{data.dek}</p>}
			<p>By <Byline authors={story.authors} /></p>
			{/* Each author's title under the byline; with two or more, named. */}
			<p>{story.authors.map((a) => (story.authors.length > 1 ? `${a.data.name}, ${a.data.title}` : a.data.title)).join("; ")}</p>
			<p>
				<time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
				{updated && <> · Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
				{" "}· {readingMinutes(story)} min read
			</p>
			<p><strong><Label story={story} source={!copied} /></strong></p>
			{recipe && (
				<p data-screen-only>
					<a href="#recipe">Jump to recipe</a> · <button type="button" onclick="window.print()">Print</button>
				</p>
			)}
			{copied && (
				<p>
					First published at <a href={copied.canonical}>{copied.source}</a>.
				</p>
			)}
		</header>
		{image && (
			<figure>
				<Image src={image.src} alt={image.alt} width={1200} />
				{(image.caption || image.credit) && (
					<figcaption>
						{image.caption}
						{image.caption && image.credit && " "}
						{image.credit && <small>{image.credit}</small>}
					</figcaption>
				)}
			</figure>
		)}
		<Body story={story}>{recipe && <RecipeCard story={recipe} />}</Body>
		{recipe && <p data-clipping hidden>Clipped from {paper.name}, {url}</p>}
		{local?.updateNote && local.updated && (
			<p>
				<strong>Update, <time datetime={local.updated.toISOString()}>{formatDate(local.updated)}</time>:</strong> {local.updateNote}
			</p>
		)}
		{local && local.corrections.length > 0 && (
			<section aria-labelledby="corrections">
				<h2 id="corrections">{local.corrections.length > 1 ? "Corrections" : "Correction"}</h2>
				<ul>
					{local.corrections.map((c) => (
						<li><time datetime={c.date.toISOString()}>{formatDate(c.date)}</time>: {c.text}</li>
					))}
				</ul>
			</section>
		)}
		{tags.length > 0 && (
			<nav aria-label="Tags" data-pagefind-ignore>
				<ul>
					{tags.map((t) => <li><a href={tagHref(t)} rel="tag">{tagLabel(t)}</a></li>)}
				</ul>
			</nav>
		)}
		<AuthorBox authors={story.authors} />
	</article>
	{related.length > 0 && (
		<section aria-labelledby="related">
			<h2 id="related">Related</h2>
			<StoryList stories={related} />
		</section>
	)}
	{(previous || next) && (
		<nav aria-label={`More in ${section.label}`}>
			<ul>
				{previous && <li>Previous: <a href={storyHref(previous)} rel="prev">{previous.entry.data.title}</a></li>}
				{next && <li>Next: <a href={storyHref(next)} rel="next">{next.entry.data.title}</a></li>}
			</ul>
		</nav>
	)}
</Layout>
