---
// About the paper: src/content/pages/about.md, then how to reach it. Its
// structured data is an AboutPage about the paper, policies and all.
import paper from "../../paper.config";
import Contact from "../theme/Contact.astro";
import Page from "../theme/Page.astro";
import { getPage, paperLd } from "../theme/paper";

const page = await getPage("about");
---

<Page paper={paper} page={page} type="AboutPage" ld={{ mainEntity: paperLd(paper) }}>
	<p>Contact: <Contact paper={paper} /></p>
</Page>
