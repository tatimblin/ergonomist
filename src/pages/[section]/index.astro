---
// A section: its stories, newest first, and its feed. An empty one is
// noindex, and out of the sitemap, until it has a story.
import type { GetStaticPaths } from "astro";
import paper from "../../../paper.config";
import Layout from "../../theme/Layout.astro";
import StoryList from "../../theme/StoryList.astro";
import { collectionLd, getStories, rssHref, sectionHref, type Section, type Story } from "../../theme/paper";

export const getStaticPaths = (async () => {
	const stories = await getStories(paper);
	return paper.sections.map((section) => ({
		params: { section: section.id },
		props: { section, stories: stories.filter((s) => s.section === section.id) },
	}));
}) satisfies GetStaticPaths;

const { section, stories } = Astro.props as { section: Section; stories: Story[] };
const feed = rssHref(sectionHref(section.id));
---

<Layout
	paper={paper}
	title={section.label}
	noindex={stories.length === 0}
	jsonLd={collectionLd(paper, section.label, sectionHref(section.id), stories)}
	feed={{ title: `${section.label} — ${paper.name}`, href: feed }}
>
	<h1>{section.label}</h1>
	{stories.length ? <StoryList stories={stories} level={2} /> : <p>Nothing here yet.</p>}
	<p><a href={feed}>RSS</a></p>
</Layout>
